# Single canonical source for hosting: copy to `.env` at the ROOT (not committed).
# Locally, `apps/web/.env*` also work as a fallback — but do not duplicate values:
# the root file wins when the hosting only mounts one file.
#
# SECURITY RULES (important):
# - NEVER put secrets under the `NEXT_PUBLIC_` prefix (they ship to the browser).
#   Only `NEXT_PUBLIC_APP_NAME`, `NEXT_PUBLIC_APP_URL` and `NEXT_PUBLIC_SITE_URL`
#   are public. Everything else is SERVER-ONLY.
# - `.env` is never committed (see `.gitignore`). This file carries placeholders
#   only, no real secrets.
# - On your host, paste the values into the env panel or upload the `.env`
#   with 600 permissions. Variables already defined in the environment always
#   win (the code never overwrites them).

# --- App (public, safe to expose) ---
NEXT_PUBLIC_APP_NAME="Stackgoat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Server-only (used in admin metadata). May repeat the public name.

# --- Database (REQUIRED, server-only) ---
DATABASE_URL="postgresql://user:password@localhost:5432/app?schema=public"

# --- Auth (REQUIRED, server-only) ---
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email SMTP (optional, server-only; without it the magic link goes to console) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Stackgoat <no-reply@yourdomain.com>"

# --- One-off seed (optional, local only) ---
# SEED_ROOT_EMAIL="you@email.com"
# SEED_ROOT_NAME="Your Name"

# --- S3 storage (legacy / optional: the code does not use it today) ---
# Uncomment only if you need it. Never with the NEXT_PUBLIC_ prefix.
# ACCESS_KEY_ID=""
# SECRET_ACCESS_KEY=""
# REGION=""
# BUCKET_NAME=""
# ENDPOINT=""
