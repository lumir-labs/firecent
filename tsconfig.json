{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // next-intl generates packages/lib/src/messages/es.d.json.ts (strict types).
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@app/api": ["./packages/api/src/index.ts"],
      "@app/api/*": ["./packages/api/src/*"],
      "@app/db": ["./packages/db/src/index.ts"]
    }
  }
}
