{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@app/api": ["../../packages/api/src/index.ts"],
      "@app/api/*": ["../../packages/api/src/*"],
      "@app/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["src", "scripts"]
}
