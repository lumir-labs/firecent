# Better Auth + tRPC backend (same base for auth-client and trpc; see
# src/lib/api-base-url.ts). Without this variable the app falls back to
# localhost with a visible warning: never hardcode your personal LAN IP in
# the code (gap G4).
#
# - iOS Simulator / Expo web: http://localhost:3000 is enough.
# - Physical device or Android emulator: `localhost` does NOT reach the
#   device; use your machine's LAN IP on the same Wi-Fi, e.g.
#   http://192.168.1.10:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Native Google OAuth (same project as the web; client IDs are public, not secrets).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=632977056482-fhfuncav047ei8ikcpnml573j47km61m.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=632977056482-foa5ut4cd2j70nnnqsb0gnp7tccqkeln.apps.googleusercontent.com
