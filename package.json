{
  "name": "app",
  "private": true,
  "packageManager": "bun@1.4.4",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@app/web",
    "dev:mobile": "turbo run dev --filter=@app/mobile",
    "start": "turbo run start --filter=@app/web",
    "android": "turbo run android --filter=@app/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@app/db",
    "db:push": "turbo run db:push --filter=@app/db",
    "db:seed": "bun apps/web/scripts/seed.ts",
    "env:check": "node scripts/check-env.mjs",
    "tokens:sync": "bun scripts/sync-tokens.ts",
    "db:migrate": "turbo run db:migrate --filter=@app/db",
    "db:studio": "turbo run db:studio --filter=@app/db",
    "db:purge": "node scripts/purge-expired.mjs",
    "docs:gen": "node scripts/gen-architecture.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "^5"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "@babel/core": "7.29.0"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "@shopify/react-native-skia",
    "prisma",
    "unrs-resolver",
    "vue-demi",
    "sharp"
  ]
}