generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  GENERAL
  BANK
  SAVINGS_ACCOUNT
  CHECKING_ACCOUNT
  CASH
  CREDIT_CARD
}

enum PaymentDayType {
  MONTHLY_DAY
  EVERY_X_DAYS
}

enum DisplayCreditMode {
  CREDIT_BALANCE
  AVAILABLE_CREDIT
}

enum RecordType {
  EXPENSE
  INCOME
  TRANSFER
}

enum PaymentType {
  CASH
  CREDIT_CARD
  WEB_PAYMENT
}

enum DebtType {
  ANYONE_TO_ME
  ME_TO_ANYONE
}

enum SpendingNature {
  DEBO
  NECESITO
  QUIERO
}

enum Colors {
  DEFAULT
  GRAY
  BROWN
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
  RED
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  label       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt
  deletedAt   DateTime?
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  label       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  roles       Role[]    @relation("PermissionToRole")
}

model User {
  id               String        @id @default(uuid(7))
  email            String        @unique
  name             String?
  firstName        String?
  middleName       String?
  lastName         String?
  lastName2        String?
  isOnboarded      Boolean       @default(false)
  emailVerified    Boolean       @default(false)
  pwdReset         Boolean       @default(false)
  image            String?
  // Required by better-auth's `twoFactor` plugin.
  twoFactorEnabled Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  accounts         Account[]
  sentInvitations  Invitation[]  @relation("Inviter")
  memberships      Member[]
  sessions         Session[]
  roles            Role[]        @relation("RoleToUser")
  createdApiKeys     ApiKey[]
  twoFactors         TwoFactor[]
  bankAccounts           BankAccount[]
  assistantThreads       AssistantThread[]
  assistantProposals     AssistantProposal[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
}

model Session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime @db.Timestamptz(3)
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @db.Timestamptz(3)
  updatedAt            DateTime @db.Timestamptz(3)
  // Required by better-auth's `organization` plugin: stores the
  // session's active organization.
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model BankAccount {
  id                Int                @id @default(autoincrement())
  organizationId    String             @db.Uuid()
  userId            String
  name              String
  description       String?
  type              AccountType        @default(GENERAL)
  currency          String             @default("USD")
  color             String?
  hasCard           Boolean            @default(false)
  balance           Int                @default(0)
  balanceDisplay    Float              @default(0)
  accountNumber     String?
  position          Int                @default(0)
  excludeFromStats  Boolean            @default(false)
  isActive          Boolean            @default(true)
  archived          Boolean            @default(false)
  creditLimit       Int?
  paymentDayType    PaymentDayType?    @default(MONTHLY_DAY)
  paymentDay        Int?
  paymentEveryDays  Int?
  paymentAnchorDate DateTime?          @db.Date
  cutoffDayType     PaymentDayType?    @default(MONTHLY_DAY)
  cutoffDay         Int?
  cutoffEveryDays   Int?
  cutoffAnchorDate  DateTime?          @db.Date
  displayCreditMode DisplayCreditMode? @default(CREDIT_BALANCE)
  interestRate      Float?
  createdBy         String?
  updatedBy         String?
  deletedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  records         Record[]          @relation("RecordAccount")
  transferRecords Record[]          @relation("RecordTransferAccount")
  debtsFrom       Debt[]            @relation("DebtFromAccount")
  installments    CardInstallment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([userId])
}

model CardInstallment {
  id                Int       @id @default(autoincrement())
  organizationId    String    @db.Uuid()
  accountId         Int
  title             String
  /** Original purchase principal in minor units (cents). */
  totalAmount       Int
  totalInstallments Int
  paidInstallments  Int       @default(0)
  /** Fixed monthly quota in minor units (cents). */
  monthlyAmount     Int
  /** Annual interest rate % (0 = sin intereses / 0% plan). */
  interestRate      Float     @default(0)
  startDate         DateTime  @db.Date
  /** True when remaining installment balance is already reflected in card debt/limit. */
  includedInBalance Boolean   @default(true)
  note              String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([accountId])
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String
  nameEn         String?
  nameEs         String?
  isSystem       Boolean         @default(false)
  color          String?
  icon           String?
  type           RecordType      @default(EXPENSE)
  spendingNature SpendingNature? @default(NECESITO)
  hidden         Boolean         @default(false)
  parentId       Int?
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryHierarchy")
  organizationId String          @db.Uuid()
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records          Record[]
  budgetCategories BudgetCategory[]

  @@index([organizationId])
  @@index([parentId])
}

model Payee {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  organizationId String    @db.Uuid()
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Envelope {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  organizationId String    @db.Uuid()
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Record {
  id                Int         @id @default(autoincrement())
  organizationId    String      @db.Uuid()
  accountId         Int
  categoryId        Int?
  payeeId           Int?
  envelopeId        Int?
  type              RecordType      @default(EXPENSE)
  spendingNature    SpendingNature?
  paymentType       PaymentType     @default(CASH)
  paymentTypeLocal  String?
  amount            Int
  refCurrencyAmount Int?
  note              String?
  recordDate        DateTime?   @db.Date
  recordTime        DateTime?   @db.Time
  transfer          Boolean     @default(false)
  transferGroupId   Int?
  gpsLatitude       Decimal?    @db.Decimal(12, 8)
  gpsLongitude      Decimal?    @db.Decimal(12, 8)
  gpsAccuracy       Decimal?    @db.Decimal(12, 2)
  warrantyInMonth   Int?
  customCategory    Boolean         @default(false)
  excludeFromStats  Boolean         @default(false)
  recurringId       Int?

  createdBy String?
  updatedBy String?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account           BankAccount  @relation("RecordAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccountId Int?
  transferAccount   BankAccount? @relation("RecordTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category          Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payee             Payee?       @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  envelope          Envelope?    @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recordsOnDebts Debt[]  @relation("DebtRecords")
  labels         Label[]

  @@index([organizationId])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([payeeId])
  @@index([recordDate])
  @@index([type])
  @@index([organizationId, transfer, transferGroupId])
}

model Debt {
  id              Int       @id @default(autoincrement())
  organizationId  String    @db.Uuid()
  accountId       Int?
  type            DebtType
  name            String
  note            String?
  amount          Int
  remainingAmount Int?
  currency        String    @default("USD")
  creationDate    DateTime
  payBackDate     DateTime?
  paidBack        Boolean   @default(false)
  createdBy       String?
  updatedBy       String?
  deletedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      BankAccount? @relation("DebtFromAccount", fields: [accountId], references: [id], onDelete: SetNull)
  records      Record[]     @relation("DebtRecords")

  @@index([organizationId])
  @@index([accountId])
  @@index([paidBack])
}

model Label {
  id             Int          @id @default(autoincrement())
  name           String
  color          String?
  organizationId String       @db.Uuid()
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        Record[]
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

model Organization {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String        @unique
  slug         String?       @unique
  logo         String?
  description  String?
  metadata     String?
  createdBy    String?
  updatedBy    String?
  deletedBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
  deletedAt    DateTime?
  invitations  Invitation[]
  members      Member[]
  apiKeys      ApiKey[]
  labels       Label[]
  bankAccounts     BankAccount[]
  cardInstallments CardInstallment[]
  categories   Category[]
  payees       Payee[]
  envelopes    Envelope[]
  records      Record[]
  debts              Debt[]
  budgets            Budget[]
  recurrings         Recurring[]
  assistantThreads        AssistantThread[]
  assistantProposals      AssistantProposal[]
  notificationPreferences NotificationPreference[]

  @@map("organization")
}

model Member {
  id             String       @id @default(uuid(7))
  organizationId String       @db.Uuid
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid(7))
  organizationId String       @db.Uuid
  email          String
  role           String?      @default("member")
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  inviter        User         @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invitation")
}

model ApiKey {
  id             String       @id @default(uuid(7))
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String
  keyHash        String       @unique
  scopes         String[]     @default([])
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([prefix])
  @@map("api_key")
}

// Required by better-auth's `twoFactor` plugin (TOTP + backup codes).
// `secret` and `backupCodes` never leave through the API (`returned: false` in the plugin).
model TwoFactor {
  id                      String    @id @default(uuid(7))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@map("two_factor")
}

/// Emails waiting for access. Added from the landing or manually in the admin.
/// Soft delete: `deletedAt`; re-adding a deleted email restores the row.
model Waitlist {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  createdBy String?
  deletedBy String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("waitlist")
}

// ── Firecent: Budget & Recurring (additive) ──────────────────────────────

enum RecurringMode {
  AUTO
  MANUAL
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum OccurrenceStatus {
  PENDING
  CONFIRMED
  SKIPPED
}

model Budget {
  id             Int       @id @default(autoincrement())
  organizationId String    @db.Uuid
  month          DateTime  @db.Date
  expectedIncome Int       @default(0)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  natures      BudgetNature[]
  categories   BudgetCategory[]

  @@unique([organizationId, month])
  @@index([organizationId])
}

model BudgetNature {
  id       Int            @id @default(autoincrement())
  budgetId Int
  nature   SpendingNature
  amount   Int

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, nature])
}

model BudgetCategory {
  id         Int @id @default(autoincrement())
  budgetId   Int
  categoryId Int
  amount     Int

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
}

model Recurring {
  id                Int                @id @default(autoincrement())
  organizationId    String             @db.Uuid
  name              String
  type              RecordType         @default(EXPENSE)
  amount            Int
  isEstimate        Boolean            @default(false)
  accountId         Int
  transferAccountId Int?
  categoryId        Int?
  payeeId           Int?
  mode              RecurringMode      @default(MANUAL)
  frequency         RecurringFrequency @default(MONTHLY)
  interval          Int                @default(1)
  daysOfMonth       Int[]              @default([])
  startDate         DateTime           @db.Date
  nextDate          DateTime?          @db.Date
  endDate           DateTime?          @db.Date
  pausedAt          DateTime?
  note              String?
  createdBy         String?
  updatedBy         String?
  deletedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occurrences  RecurringOccurrence[]

  @@index([organizationId])
  @@index([nextDate])
}

model RecurringOccurrence {
  id          Int              @id @default(autoincrement())
  recurringId Int
  dueDate     DateTime         @db.Date
  amount      Int
  status      OccurrenceStatus @default(PENDING)
  recordId    Int?             @unique
  decidedBy   String?
  decidedAt   DateTime?

  recurring Recurring @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, dueDate])
}

// ── Firecent: AI Assistant ───────────────────────────────────────────────

enum AssistantRole {
  USER
  ASSISTANT
}

enum AssistantProposalKind {
  STATEMENT_IMPORT
  TRANSFER_MATCH
}

enum AssistantProposalStatus {
  AWAITING_ACCOUNT
  PENDING
  APPLIED
  DISMISSED
  SUPERSEDED
}

model AssistantThread {
  id              String    @id @default(uuid(7))
  organizationId  String    @db.Uuid
  userId          String
  title           String
  activeAccountId Int?
  contextJson     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AssistantMessage[]
  proposals    AssistantProposal[]

  @@index([organizationId, userId, updatedAt])
  @@map("assistant_thread")
}

model AssistantMessage {
  id          String        @id @default(uuid(7))
  threadId    String
  role        AssistantRole
  content     String
  attachments Json?
  uiBlocks    Json?
  tokenUsage  Json?
  createdAt   DateTime      @default(now())

  thread    AssistantThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  proposals AssistantProposal[]

  @@index([threadId, createdAt])
  @@map("assistant_message")
}

model AssistantProposal {
  id               String                  @id @default(uuid(7))
  organizationId   String                  @db.Uuid
  userId           String
  threadId         String
  messageId        String?
  kind             AssistantProposalKind   @default(STATEMENT_IMPORT)
  status           AssistantProposalStatus @default(PENDING)
  accountId        Int?
  title            String
  payload          Json
  appliedRecordIds Int[]                   @default([])
  appliedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread       AssistantThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message      AssistantMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status])
  @@index([threadId, status])
  @@map("assistant_proposal")
}

// ── Firecent: PWA Web Push Notifications ─────────────────────────────────

model NotificationPreference {
  id                 String    @id @default(uuid(7))
  userId             String    @unique
  organizationId     String?   @db.Uuid
  enabled            Boolean   @default(false)
  /** Daily delivery time in 24h local "HH:MM" format (e.g. "08:00"). */
  dailyTime          String    @default("08:00")
  /** IANA timezone identifier (e.g. "America/El_Salvador"). */
  timezone           String    @default("America/El_Salvador")
  /** Preferred notification copy language ("es" | "en"). */
  locale             String    @default("es")
  /** Days ahead to warn about upcoming card payments, recurrings, and debts. */
  advanceDays        Int       @default(3)
  notifyCardPayments Boolean   @default(true)
  notifyCardCutoffs  Boolean   @default(true)
  notifyRecurrings   Boolean   @default(true)
  notifyDebts        Boolean   @default(true)
  notifyInstallments Boolean   @default(false)
  /** Skip push delivery on days when there are zero pending items. */
  quietIfEmpty       Boolean   @default(true)
  /** Indexed UTC timestamp of the next scheduled delivery for O(log N) cron queries. */
  nextRunAt          DateTime?
  /** Local "YYYY-MM-DD" of the last sent daily digest (idempotency guard). */
  lastSentDate       String?
  lastSentAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([enabled, nextRunAt])
  @@map("notification_preference")
}

model PushSubscription {
  id           String    @id @default(uuid(7))
  userId       String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  deviceLabel  String?
  lastUsedAt   DateTime?
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}
