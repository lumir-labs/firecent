generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  GENERAL
  BANK
  SAVINGS_ACCOUNT
  CHECKING_ACCOUNT
  CASH
  CREDIT_CARD
}

enum PaymentDayType {
  MONTHLY_DAY
  EVERY_X_DAYS
}

enum DisplayCreditMode {
  CREDIT_BALANCE
  AVAILABLE_CREDIT
}

enum RecordType {
  EXPENSE
  INCOME
  TRANSFER
}

enum PaymentType {
  CASH
  CREDIT_CARD
  WEB_PAYMENT
}

enum DebtType {
  ANYONE_TO_ME
  ME_TO_ANYONE
}

enum SpendingNature {
  DEBO
  NECESITO
  QUIERO
}

enum Colors {
  DEFAULT
  GRAY
  BROWN
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
  RED
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  label       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt
  deletedAt   DateTime?
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  label       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  roles       Role[]    @relation("PermissionToRole")
}

model User {
  id               String        @id @default(uuid(7))
  email            String        @unique
  name             String?
  firstName        String?
  middleName       String?
  lastName         String?
  lastName2        String?
  isOnboarded      Boolean       @default(false)
  emailVerified    Boolean       @default(false)
  pwdReset         Boolean       @default(false)
  image            String?
  // Required by better-auth's `twoFactor` plugin.
  twoFactorEnabled Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  accounts         Account[]
  sentInvitations  Invitation[]  @relation("Inviter")
  memberships      Member[]
  sessions         Session[]
  roles            Role[]        @relation("RoleToUser")
  createdApiKeys   ApiKey[]
  twoFactors       TwoFactor[]
  bankAccounts     BankAccount[]
}

model Session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime @db.Timestamptz(3)
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @db.Timestamptz(3)
  updatedAt            DateTime @db.Timestamptz(3)
  // Required by better-auth's `organization` plugin: stores the
  // session's active organization.
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model BankAccount {
  id                Int                @id @default(autoincrement())
  organizationId    String             @db.Uuid()
  userId            String
  name              String
  description       String?
  type              AccountType        @default(GENERAL)
  currency          String             @default("USD")
  color             String?
  balance           Int                @default(0)
  balanceDisplay    Float              @default(0)
  accountNumber     String?
  position          Int                @default(0)
  excludeFromStats  Boolean            @default(false)
  isActive          Boolean            @default(true)
  archived          Boolean            @default(false)
  creditLimit       Int?
  paymentDayType    PaymentDayType?    @default(MONTHLY_DAY)
  paymentDay        Int?
  paymentEveryDays  Int?
  displayCreditMode DisplayCreditMode? @default(CREDIT_BALANCE)
  interestRate      Float?
  createdBy         String?
  updatedBy         String?
  deletedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  records         Record[]     @relation("RecordAccount")
  transferRecords Record[]     @relation("RecordTransferAccount")
  debtsFrom       Debt[]       @relation("DebtFromAccount")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([userId])
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String
  color          String?
  icon           String?
  spendingNature SpendingNature? @default(NECESITO)
  hidden         Boolean         @default(false)
  parentId       Int?
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryHierarchy")
  organizationId String          @db.Uuid()
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
}

model Payee {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  organizationId String    @db.Uuid()
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Envelope {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  organizationId String    @db.Uuid()
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Record {
  id                Int         @id @default(autoincrement())
  organizationId    String      @db.Uuid()
  accountId         Int
  categoryId        Int?
  payeeId           Int?
  envelopeId        Int?
  type              RecordType  @default(EXPENSE)
  paymentType       PaymentType @default(CASH)
  paymentTypeLocal  String?
  amount            Int
  refCurrencyAmount Int?
  note              String?
  recordDate        DateTime?   @db.Date
  recordTime        DateTime?   @db.Time
  transfer          Boolean     @default(false)
  transferGroupId   Int?
  gpsLatitude       Decimal?    @db.Decimal(12, 8)
  gpsLongitude      Decimal?    @db.Decimal(12, 8)
  gpsAccuracy       Decimal?    @db.Decimal(12, 2)
  warrantyInMonth   Int?
  customCategory    Boolean     @default(false)

  createdBy String?
  updatedBy String?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account           BankAccount  @relation("RecordAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccountId Int?
  transferAccount   BankAccount? @relation("RecordTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category          Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payee             Payee?       @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  envelope          Envelope?    @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recordsOnDebts Debt[]  @relation("DebtRecords")
  labels         Label[]

  @@index([organizationId])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([payeeId])
  @@index([recordDate])
  @@index([type])
}

model Debt {
  id              Int       @id @default(autoincrement())
  organizationId  String    @db.Uuid()
  accountId       Int?
  type            DebtType
  name            String
  note            String?
  amount          Int
  remainingAmount Int?
  creationDate    DateTime
  payBackDate     DateTime?
  paidBack        Boolean   @default(false)
  createdBy       String?
  updatedBy       String?
  deletedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      BankAccount? @relation("DebtFromAccount", fields: [accountId], references: [id], onDelete: SetNull)
  records      Record[]     @relation("DebtRecords")

  @@index([organizationId])
  @@index([accountId])
  @@index([paidBack])
}

model Label {
  id             Int          @id @default(autoincrement())
  name           String
  color          String?
  organizationId String       @db.Uuid()
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        Record[]
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

model Organization {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String        @unique
  slug         String?       @unique
  logo         String?
  description  String?
  metadata     String?
  createdBy    String?
  updatedBy    String?
  deletedBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
  deletedAt    DateTime?
  invitations  Invitation[]
  members      Member[]
  apiKeys      ApiKey[]
  labels       Label[]
  bankAccounts BankAccount[]
  categories   Category[]
  payees       Payee[]
  envelopes    Envelope[]
  records      Record[]
  debts        Debt[]

  @@map("organization")
}

model Member {
  id             String       @id @default(uuid(7))
  organizationId String       @db.Uuid
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid(7))
  organizationId String       @db.Uuid
  email          String
  role           String?      @default("member")
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  inviter        User         @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invitation")
}

model ApiKey {
  id             String       @id @default(uuid(7))
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String
  keyHash        String       @unique
  scopes         String[]     @default([])
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([prefix])
  @@map("api_key")
}

// Required by better-auth's `twoFactor` plugin (TOTP + backup codes).
// `secret` and `backupCodes` never leave through the API (`returned: false` in the plugin).
model TwoFactor {
  id                      String    @id @default(uuid(7))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@map("two_factor")
}

/// Emails waiting for access. Added from the landing or manually in the admin.
/// Soft delete: `deletedAt`; re-adding a deleted email restores the row.
model Waitlist {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  createdBy String?
  deletedBy String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("waitlist")
}
